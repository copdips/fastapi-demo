# Values used by CI. There is no external database: the compose `postgres`
# service is the only one, and the app containers reach it by service name.
# Host-side pytest runs with TESTING=yes and uses in-memory sqlite, so these
# values only have to satisfy the required settings fields, not to be reachable
# from the runner itself.
DB_NAME=fastapi-demo-local
DB_PASSWORD=postgres
DB_USERNAME=postgres
DB_HOST=postgres
DB_PORT=5432
DB_CONN_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/fastapi-demo-local
APPLICATIONINSIGHTS_CONNECTION_STRING=demo
LOGFIRE_TOKEN=demo
# sentry_sdk.init rejects an empty dsn at startup; any syntactically valid
# dummy works while TESTING is off (the api container does not set it).
SENTRY_DSN=https://public@example.com/1
